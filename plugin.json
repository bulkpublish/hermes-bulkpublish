{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "bulkpublish",
  "version": "1.0.0",
  "description": "BulkPublish (https://www.bulkpublish.com) for Hermes Agent: draft, schedule and publish social media posts across 15 networks, manage media, channels and approvals, and read analytics through BulkPublish's hosted MCP server.",
  "author": {
    "name": "BulkPublish",
    "email": "support@bulkpublish.com",
    "url": "https://www.bulkpublish.com"
  },
  "homepage": "https://www.bulkpublish.com",
  "repository": "https://github.com/bulkpublish/hermes-bulkpublish",
  "license": "MIT",
  "keywords": [
    "bulkpublish",
    "social-media",
    "scheduling",
    "social-media-scheduler",
    "content-calendar",
    "analytics",
    "instagram",
    "tiktok",
    "linkedin",
    "youtube",
    "mcp",
    "hermes-agent"
  ],
  "extensions": {
    "com.nousresearch.hermes": {
      "servers": {
        "bulkpublish": {
          "trust": "untrusted"
        }
      }
    }
  }
}
